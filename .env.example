# ============================================================
# Cynbit Smart Discovery - Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ============================================================

# ----- Database -----
# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb://Swarnalakshmi:zW7h0fvE7KQc4K8w@ac-lss5tol-shard-00-00.skpixxc.mongodb.net:27017,ac-lss5tol-shard-00-01.skpixxc.mongodb.net:27017,ac-lss5tol-shard-00-02.skpixxc.mongodb.net:27017/cynbit?ssl=true&replicaSet=atlas-hc92xs-shard-0&authSource=admin&appName=Cluster0

# ----- Authentication -----
# Generate with: openssl rand -base64 64
# Or PowerShell: -join ((65..90 + 97..122 + 48..57) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=your-very-long-random-secret-string-at-least-32-chars

# ----- Admin Account (used by seed script) -----
# These are used ONCE to create the initial admin in MongoDB
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_NAME=Cynbit Administrator

# ----- Email (Optional - app works without this) -----
# Get from: https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=admin@cynbit.in

# ----- App URL -----
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel dashboard)
# NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

